# ---------------------------------------------------------------------------
# FluxTip environment template. Copy to .env (chmod 600) and fill in real values.
# These are placeholders, not credentials. NEVER commit .env.
#
# Any token, API key or webhook secret that has ever been pasted into a chat,
# screenshot, issue or commit must be rotated in the Discord Developer Portal
# and the OrbChain dashboard before it is used here.
# ---------------------------------------------------------------------------

# Discord application (Developer Portal -> General Information / Bot)
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id

# "simulated" uses the in-process fake provider (safe for development and tests).
# "live" talks to the real OrbChain API and requires the four OrbChain values.
PROVIDER_MODE=simulated

# OrbChain merchant credentials. Each key is scoped to a different API surface.
ORBCHAIN_MERCHANT_API_KEY=
ORBCHAIN_PAYOUT_API_KEY=
ORBCHAIN_GENERAL_API_KEY=
ORBCHAIN_WEBHOOK_SECRET=
ORBCHAIN_BASE_URL=https://orbchain.io
# Public HTTPS URL of /webhooks/orbchain (same URL configured in OrbChain)
ORBCHAIN_WEBHOOK_URL=
ORBCHAIN_WEBHOOK_PORT=8787

# Live payouts stay disabled until the integration is reviewed and tested.
WITHDRAWALS_LIVE=false

# Comma-separated numeric Discord user IDs allowed to use /admin (never usernames)
ADMIN_USER_IDS=

# Storage and logging
DATABASE_PATH=./data/fluxtip.db
BACKUP_DIR=./data/backups
LOG_LEVEL=info
NODE_ENV=production

# Notional limits in USD
MIN_WITHDRAW_USD=1
MAX_WITHDRAW_USD=1000
MAX_RAIN_RECIPIENTS=25

# Optional community links
SUPPORT_SERVER_URL=
STATUS_PAGE_URL=
