[Unit]
Description=FluxTip SQLite backup

[Service]
Type=oneshot
User=fluxtip
Group=fluxtip
WorkingDirectory=/opt/fluxtip
EnvironmentFile=/etc/fluxtip/fluxtip.env
ExecStart=/usr/bin/node dist/scripts/backup.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fluxtip
