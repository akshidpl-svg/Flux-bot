[Unit]
Description=FluxTip Discord crypto wallet and tipping bot
Documentation=https://github.com/your-org/FluxTip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fluxtip
Group=fluxtip
WorkingDirectory=/opt/fluxtip
# Secrets live here, root:fluxtip 0640. Never in the repository.
EnvironmentFile=/etc/fluxtip/fluxtip.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
# SIGTERM lets the bot stop the webhook server and close SQLite cleanly.
KillSignal=SIGTERM
TimeoutStopSec=30
# Tighten the sandbox: only the data directory is writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/fluxtip
UMask=0077
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fluxtip

[Install]
WantedBy=multi-user.target
